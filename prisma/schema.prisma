// ============================================================
// لمسة جمال — Beauty POS — Prisma Schema (Rebuilt)
// ============================================================
// Consistent with db/supabase-schema.sql and db/sqlite-schema.sql.
//
// ARCHITECTURE NOTE:
//   The production app talks to Supabase via the REST API (PostgREST)
//   through src/lib/data/client.ts — NOT via Prisma Client.
//   This schema exists for:
//     1. Local development with `prisma db push` (SQLite — fast setup)
//     2. Type-safety reference & documentation
//     3. Future migration to a Prisma-managed Postgres if desired
//
// Provider: sqlite for local dev (matches the .env DATABASE_URL=file:./db/dev.db).
// The cloud schema (db/supabase-schema.sql) uses PostgreSQL and is the
// source of truth for production.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // file:./db/dev.db for local dev
}

// ============ AUTH & USERS ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String   @default("CASHIER") // OWNER, ADMIN, MANAGER, CASHIER, WAREHOUSE, ACCOUNTANT, PLATFORM
  permissions  String   @default("[]") // JSON array of permission strings
  active       Boolean  @default(true)
  pin          String?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales          Sale[]
  purchases      Purchase[]
  cashSessions   CashSession[]
  expenses       Expense[]
  stockAdjust    StockAdjustment[]
  auditLogs      AuditLog[]
  saleReturns    SaleReturn[]
  stockMovements StockMovement[]

  @@index([role])
  @@index([active])
}

// ============ STORE & REGISTER ============

model Store {
  id            String    @id @default(cuid())
  name          String
  address       String?
  phone         String?
  email         String?
  taxId         String?
  currency      String    @default("EGP")
  logo          String?
  receiptFooter String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  registers  Register[]
  products   Product[]
  sales      Sale[]
  purchases  Purchase[]
  warehouses Warehouse[]
}

model Register {
  id        String   @id @default(cuid())
  name      String
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cashSessions CashSession[]
  sales        Sale[]

  @@index([storeId])
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  @@index([storeId])
}

// ============ PRODUCTS ============

model Category {
  id        String     @id @default(cuid())
  name      String
  nameAr    String?
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  color     String?
  icon      String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products Product[]

  @@index([parentId])
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Unit {
  id        String   @id @default(cuid())
  name      String
  shortName String?
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id                 String   @id @default(cuid())
  name               String
  nameAr             String?
  sku                String   @unique
  barcode            String?  @unique
  barcodes           String   @default("[]") // JSON array of additional barcodes
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id])
  brandId            String?
  brand              Brand?   @relation(fields: [brandId], references: [id])
  unitId             String?
  unit               Unit?    @relation(fields: [unitId], references: [id])
  supplierId         String?
  supplier           Supplier? @relation(fields: [supplierId], references: [id])
  storeId            String?
  store              Store?   @relation(fields: [storeId], references: [id])

  // Pricing — stored as Float in SQLite; the data layer rounds to 2 decimals.
  // (PostgreSQL production uses DECIMAL(12,2) — see db/supabase-schema.sql)
  purchaseCost       Float    @default(0)
  sellingPrice       Float    @default(0)
  wholesalePrice     Float    @default(0)
  taxRate            Float    @default(0)

  minStock           Int      @default(0)
  reorderLevel       Int      @default(0)
  trackStock         Boolean  @default(true)
  allowNegativeStock Boolean  @default(false)
  avgCost            Float    @default(0)

  image              String?
  description        String?
  active             Boolean  @default(true)

  // Local-only denormalized fields (desktop/offline)
  currentStock       Int      @default(0)
  syncStatus         String   @default("synced")
  pendingStockDelta  Int      @default(0)
  lastSynced         BigInt   @default(0)   // epoch ms (64-bit — Int overflows in 2038)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  saleReturnItems SaleReturnItem[]

  @@index([categoryId])
  @@index([supplierId])
  @@index([brandId])
  @@index([active])
  @@index([syncStatus])
}

// ============ INVENTORY ============

model StockLevel {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

model StockMovement {
  id           String   @id @default(cuid())
  clientTxnId  String?  @unique
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  type         String   // PURCHASE, SALE, RETURN, ADJUSTMENT, TRANSFER_IN, TRANSFER_OUT, DAMAGE, OPENING_STOCK
  quantity     Int
  refType      String?
  refId        String?
  note         String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  syncStatus   String   @default("synced")

  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([refType, refId])
  @@index([createdAt])
}

model StockAdjustment {
  id           String   @id @default(cuid())
  clientTxnId  String?  @unique
  productId    String
  warehouseId  String
  oldQuantity  Int
  newQuantity  Int
  reason       String
  note         String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([warehouseId])
}

// ============ SUPPLIERS & PURCHASES ============

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  taxId     String?
  balance   Float    @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  purchases Purchase[]
}

model Purchase {
  id             String   @id @default(cuid())
  clientTxnId    String?  @unique
  invoiceNumber  String
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  storeId        String?
  store          Store?   @relation(fields: [storeId], references: [id])
  warehouseId    String?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])

  subtotal       Float    @default(0)
  taxAmount      Float    @default(0)
  discountAmount Float    @default(0)
  total          Float    @default(0)
  paidAmount     Float    @default(0)
  status         String   @default("RECEIVED")

  note           String?
  syncStatus     String   @default("synced")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items PurchaseItem[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitCost    Float
  taxRate     Float    @default(0)
  total       Float

  @@index([purchaseId])
  @@index([productId])
}

// ============ CUSTOMERS & LOYALTY ============

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?
  address   String?
  notes     String?
  birthday  DateTime?
  tier      String   @default("BRONZE")
  active    Boolean  @default(true)

  // Denormalized loyalty for fast POS display
  loyaltyPoints  Int      @default(0)
  totalEarned    Int      @default(0)
  totalRedeemed  Int      @default(0)
  lastSynced     BigInt   @default(0)   // epoch ms

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales              Sale[]
  loyaltyAccount     LoyaltyAccount?
  loyaltyTransactions LoyaltyTransaction[]

  @@index([tier])
}

model LoyaltyTier {
  id                String  @id @default(cuid())
  name              String
  displayName       String
  minPoints         Int     @default(0)
  earningMultiplier Float   @default(1.0)
  discountPercent   Float   @default(0)
  color             String?
}

model LoyaltyAccount {
  id            String   @id @default(cuid())
  customerId    String   @unique
  customer      Customer @relation(fields: [customerId], references: [id])
  points        Int      @default(0)
  totalEarned   Int      @default(0)
  totalRedeemed Int      @default(0)
  tier          String   @default("BRONZE")
  updatedAt     DateTime @updatedAt
}

model LoyaltyTransaction {
  id           String   @id @default(cuid())
  clientTxnId  String?  @unique
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  type         String   // EARN, REDEEM, EXPIRE, REVERSE, BONUS, ADJUSTMENT
  points       Int
  refType      String?
  refId        String?
  note         String?
  createdAt    DateTime @default(now())
  syncStatus   String   @default("synced")

  @@index([customerId])
  @@index([type])
}

model LoyaltyCampaign {
  id               String   @id @default(cuid())
  name             String
  description      String?
  startDate        DateTime
  endDate          DateTime
  tierFilter       String?
  pointsMultiplier Float    @default(1.0)
  bonusPoints      Int      @default(0)
  minPurchase      Float    @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
}

// ============ SALES ============

model Sale {
  id             String   @id @default(cuid())
  clientTxnId    String?  @unique
  invoiceNumber  String   @unique
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  storeId        String?
  store          Store?   @relation(fields: [storeId], references: [id])
  registerId     String?
  register       Register? @relation(fields: [registerId], references: [id])

  subtotal       Float    @default(0)
  discountAmount Float    @default(0)
  discountType   String?
  taxAmount      Float    @default(0)
  total          Float    @default(0)
  paidAmount     Float    @default(0)
  changeAmount   Float    @default(0)

  status         String   @default("COMPLETED")
  paymentMethod  String   @default("CASH")
  paymentDetails String   @default("{}")

  loyaltyEarned  Int      @default(0)
  loyaltyRedeemed Int     @default(0)

  note           String?
  held           Boolean  @default(false)
  syncStatus     String   @default("pending")
  syncAttempts   Int      @default(0)
  syncError      String?
  lastSyncedAt   BigInt?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items    SaleItem[]
  payments SalePayment[]
  returns  SaleReturn[]

  @@index([customerId])
  @@index([userId])
  @@index([status])
  @@index([paymentMethod])
  @@index([createdAt])
  @@index([syncStatus])
}

model SaleItem {
  id            String  @id @default(cuid())
  saleId        String
  sale          Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  productName   String?
  quantity      Int
  unitPrice     Float
  discountAmount Float   @default(0)
  taxAmount     Float   @default(0)
  total         Float
  costAtSale    Float   @default(0)

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    String
  amount    Float
  createdAt DateTime @default(now())

  @@index([saleId])
}

model SaleReturn {
  id              String   @id @default(cuid())
  clientTxnId     String?  @unique
  returnNumber    String   @unique
  saleId          String
  sale            Sale     @relation(fields: [saleId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  subtotal        Float    @default(0)
  taxAmount       Float    @default(0)
  total           Float    @default(0)
  refundMethod    String   @default("CASH")
  reason          String?
  status          String   @default("COMPLETED")
  loyaltyReversed Int      @default(0)
  syncStatus      String   @default("pending")
  createdAt       DateTime @default(now())

  items SaleReturnItem[]

  @@index([saleId])
}

model SaleReturnItem {
  id            String     @id @default(cuid())
  saleReturnId  String
  saleReturn    SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItemId    String
  productId     String
  product       Product    @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Float
  total         Float

  @@index([saleReturnId])
}

// ============ CASH REGISTER ============

model CashSession {
  id             String    @id @default(cuid())
  registerId     String
  register       Register  @relation(fields: [registerId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  openingBalance Float     @default(0)
  closingBalance Float?
  expectedCash   Float?
  difference     Float?
  status         String    @default("OPEN")
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  updatedAt      DateTime  @updatedAt

  movements CashMovement[]

  @@index([registerId])
  @@index([userId])
  @@index([status])
}

model CashMovement {
  id           String   @id @default(cuid())
  clientTxnId  String?  @unique
  sessionId    String
  session      CashSession @relation(fields: [sessionId], references: [id])
  type         String
  amount       Float
  note         String?
  refType      String?
  refId        String?
  createdAt    DateTime @default(now())
  syncStatus   String   @default("synced")

  @@index([sessionId])
  @@index([type])
}

// ============ EXPENSES ============

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String
  nameAr    String?
  color     String?
  createdAt DateTime  @default(now())

  expenses Expense[]
}

model Expense {
  id            String   @id @default(cuid())
  clientTxnId   String?  @unique
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  amount        Float
  paymentMethod String   @default("CASH")
  note          String?
  date          DateTime @default(now())
  syncStatus    String   @default("synced")
  createdAt     DateTime @default(now())

  @@index([categoryId])
  @@index([userId])
  @@index([date])
}

// ============ SETTINGS & AUDIT ============

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  lastSynced BigInt  @default(0)   // epoch ms
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  before    String?
  after     String?
  ipAddress String?
  device    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

// ============ SYNC QUEUE ============

model SyncQueue {
  id          Int      @id @default(autoincrement())
  entityType  String
  entityId    String
  clientTxnId String
  operation   String   // CREATE, UPDATE, DELETE
  payload     String   // JSON
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  error       String?
  createdAt   DateTime @default(now())
  syncedAt    DateTime?

  @@index([status])
  @@index([createdAt])
}
