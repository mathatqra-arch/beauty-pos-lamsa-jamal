# ============================================================
# لمسة جمال — Beauty POS — Environment Variables
# ============================================================
# Copy to .env (local dev) OR set in Vercel Dashboard (production).
# NEVER commit the real .env. (.gitignore already excludes it.)
#
# ┌──────────────────────────────────────────────────────────────┐
# │  WHAT GOES WHERE                                              │
# │                                                               │
# │  NEXT_PUBLIC_*  →  public (bundled into client JS)            │
# │                    safe to expose; read-only on the client    │
# │                    Set in: .env (local) + Vercel              │
# │                                                               │
# │  everything else  →  server-only (NEVER prefixed with          │
# │                       NEXT_PUBLIC_)                            │
# │                    stays on the server; not shipped to browser │
# │                    Set in: .env (local) + Vercel              │
# │                                                               │
# │  In Vercel: all vars go in Project → Settings → Environment   │
# │             Variables (same names, no .env file).             │
# └──────────────────────────────────────────────────────────────┘
# ============================================================


# ────────────────────────────────────────────────────────────────
# 1. LOCAL DEV DATABASE  (server-only, not needed on Vercel)
# ────────────────────────────────────────────────────────────────
# Used by Prisma for `bun run db:push` + `bun run prisma/seed.ts`.
# Vercel does NOT need this — production uses Supabase only.
DATABASE_URL="file:./db/dev.db"


# ────────────────────────────────────────────────────────────────
# 2. SUPABASE — URL + ANON KEY  (PUBLIC — NEXT_PUBLIC_*)
# ────────────────────────────────────────────────────────────────
# Find in: Supabase Dashboard → Project Settings → API
#
# These are SAFE to expose in client-side code (the anon key is
# designed to be public — RLS protects the data, not the key).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...your-anon-key..."


# ────────────────────────────────────────────────────────────────
# 3. SUPABASE — SERVICE ROLE KEY  (SERVER-ONLY — NEVER public!)
# ────────────────────────────────────────────────────────────────
# ⚠️  This key BYPASSES RLS. NEVER prefix with NEXT_PUBLIC_.
# ⚠️  Used only by src/lib/data/client.ts (server-side) for
#     authenticated DB writes (the RLS policies allow the
#     `authenticated` role, which this key uses).
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...your-service-role-key..."


# ────────────────────────────────────────────────────────────────
# 4. JWT SECRET  (SERVER-ONLY — NEVER public!)
# ────────────────────────────────────────────────────────────────
# Signs JWT session tokens. Generate a strong random string:
#   openssl rand -base64 32
JWT_SECRET="change-me-to-a-64-char-random-string"


# ────────────────────────────────────────────────────────────────
# 5. APP CONFIG  (PUBLIC — optional, all have safe defaults)
# ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="لمسة جمال"
NEXT_PUBLIC_CURRENCY="EGP"
NEXT_PUBLIC_LANGUAGE="ar"


# ============================================================
# VERCEL DEPLOYMENT CHECKLIST
# ============================================================
# In Vercel → Project → Settings → Environment Variables,
# add these EXACT keys (Production + Preview + Development):
#
#   ✅ NEXT_PUBLIC_SUPABASE_URL          (public — safe to expose)
#   ✅ NEXT_PUBLIC_SUPABASE_ANON_KEY     (public — safe to expose)
#   ✅ SUPABASE_SERVICE_ROLE_KEY         (server-only — SECRET!)
#   ✅ JWT_SECRET                        (server-only — SECRET!)
#   ✅ NEXT_PUBLIC_APP_NAME              (public — optional)
#   ✅ NEXT_PUBLIC_CURRENCY              (public — optional)
#   ✅ NEXT_PUBLIC_LANGUAGE              (public — optional)
#
#   ❌ DATABASE_URL  — NOT needed on Vercel (no local SQLite in prod).
#                       If a build step complains, set it to a
#                       placeholder: "file:./db/dev.db"
#
# Mark the two SECRET vars as "Sensitive" in Vercel so they're
# masked in the dashboard.
# ============================================================
